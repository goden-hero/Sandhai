rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Fetches profile document of authenticated user
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Checks if user is authenticated AND has role 'vendor' in their profile
    function isVendor() {
      return isAuthenticated() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().role == 'vendor';
    }

    // Checks if user is authenticated AND is a vendor with APPROVED status
    function isApprovedVendor() {
      return isVendor() && (getUserData().approvalStatus == 'approved');
    }

    function isValidRole(role) {
      return role == 'customer' || role == 'vendor';
    }

    function isValidGeohash(hash) {
      return hash is string && hash.matches('[0123456789bcdefghjkmnpqrstuvwxyz]{1,12}');
    }

    function isValidLat(lat) {
      return (lat is int || lat is float) && lat >= -90.0 && lat <= 90.0;
    }

    function isValidLng(lng) {
      return (lng is int || lng is float) && lng >= -180.0 && lng <= 180.0;
    }

    // --- USERS COLLECTION ---
    // Document ID: {uid}
    match /users/{uid} {
      // Users can only read their own private profile
      allow read: if isOwner(uid);

      // Initial user profile creation (during registration)
      // Enforces that new Vendors MUST be initialized with approvalStatus == 'pending'
      // Strictly enforces valid keys to prevent arbitrary field injection
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['displayName', 'email', 'role', 'approvalStatus', 'createdAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'approvalStatus', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string
        && isValidRole(request.resource.data.role)
        && (
          (request.resource.data.role == 'vendor' && request.resource.data.approvalStatus == 'pending') ||
          (request.resource.data.role == 'customer' && (request.resource.data.approvalStatus == 'approved' || request.resource.data.approvalStatus == 'n/a'))
        )
        && request.resource.data.createdAt is timestamp
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);

      // User profile update: User CANNOT change their 'role' OR 'approvalStatus' fields
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasAll(['displayName', 'email', 'role', 'approvalStatus', 'createdAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'approvalStatus', 'createdAt', 'updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.approvalStatus == resource.data.approvalStatus
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp)
        && request.resource.data.createdAt == resource.data.createdAt;

      // User profile cannot be deleted directly by clients
      allow delete: if false;
    }

    function validStoreLocation(d) {
      return (!d.keys().hasAny(['latitude','longitude','geohash','locationConfirmedAt']))
        || (d.keys().hasAll(['latitude','longitude','geohash'])
          && isValidLat(d.latitude) && isValidLng(d.longitude) && isValidGeohash(d.geohash)
          && (!('locationConfirmedAt' in d) || (d.locationConfirmedAt is timestamp
            && d.locationConfirmedAt <= request.time && d.geohash.size() == 6)));
    }
    function validVendor(d) {
      return d.keys().hasAll(['name','phone','category','createdAt'])
        && d.keys().hasOnly(['name','phone','category','latitude','longitude','geohash','locationConfirmedAt','address','description','imageUrl','createdAt','updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
        && d.phone is string && d.phone.size() >= 5 && d.phone.size() <= 20
        && d.category is string && d.category.size() >= 1 && d.category.size() <= 50
        && (!('address' in d) || (d.address is string && d.address.size() <= 1000))
        && (!('description' in d) || (d.description is string && d.description.size() <= 1000))
        && (!('imageUrl' in d) || (d.imageUrl is string && d.imageUrl.size() <= 2048))
        && d.createdAt is timestamp
        && (!('updatedAt' in d) || d.updatedAt is timestamp)
        && validStoreLocation(d);
    }
    match /vendors/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'vendor'
        && validVendor(request.resource.data);
      allow update: if isOwner(uid) && isVendor() && validVendor(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid) && isVendor();
    }

    function validCategory(category) {
      return category is string && category in ['groceries','fresh_produce','bakery_dairy','snacks_beverages','services','other'];
    }
    function validImage(d, offerId) {
      return (d.imageUrl == '' && !d.keys().hasAny(['imagePath','imageContentType','imageSize']))
        || (d.keys().hasAll(['imagePath','imageContentType','imageSize'])
          && d.imageUrl.matches('https?://.*')
          && d.imagePath is string
          && d.imagePath.split('/').size() == 4
          && d.imagePath.split('/')[0] == 'offers'
          && d.imagePath.split('/')[1] == request.auth.uid
          && d.imagePath.split('/')[2] == offerId
          && d.imagePath.split('/')[3].matches('[a-f0-9]{64}\\.(jpg|png|webp)')
          && d.imageSize is int && d.imageSize > 0 && d.imageSize <= 5 * 1024 * 1024
          && ((d.imageContentType == 'image/jpeg' && d.imagePath.matches('.*\\.jpg'))
            || (d.imageContentType == 'image/png' && d.imagePath.matches('.*\\.png'))
            || (d.imageContentType == 'image/webp' && d.imagePath.matches('.*\\.webp'))));
    }
    function validOffer(d) {
      return d.keys().hasAll(['vendorId','title','description','category','oldPrice','newPrice','imageUrl','latitude','longitude','geohash','createdAt','expiryTime','status'])
        && d.keys().hasOnly(['vendorId','title','description','category','oldPrice','newPrice','imageUrl','imagePath','imageContentType','imageSize','latitude','longitude','geohash','locationConfirmedAt','createdAt','expiryTime','status'])
        && (!('locationConfirmedAt' in d) || (d.locationConfirmedAt is timestamp && d.locationConfirmedAt <= request.time))
        && d.vendorId is string && d.vendorId == request.auth.uid
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 100
        && d.description is string && d.description.size() <= 1000
        && validCategory(d.category)
        && d.oldPrice is number && d.oldPrice > 0 && d.oldPrice < 1000000000000
        && d.newPrice is number && d.newPrice > 0 && d.newPrice <= d.oldPrice
        && d.imageUrl is string && d.imageUrl.size() <= 2048
        && isValidLat(d.latitude) && isValidLng(d.longitude)
        && isValidGeohash(d.geohash) && d.geohash.size() == 6
        && d.createdAt is timestamp && d.expiryTime is timestamp && d.expiryTime > d.createdAt;
    }
    function confirmedStore(d) {
      let store = get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data;
      return store.locationConfirmedAt is timestamp && store.locationConfirmedAt <= request.time
        && d.latitude == store.latitude && d.longitude == store.longitude && d.geohash == store.geohash
        && (!('locationConfirmedAt' in d) || d.locationConfirmedAt == store.locationConfirmedAt);
    }
    // Permit minor client clock drift, but never an unlimited offer lifetime.
    function validPublicationTime(d) {
      return d.createdAt >= request.time - duration.value(5, 'm')
        && d.createdAt <= request.time + duration.value(5, 'm')
        && d.expiryTime > request.time
        && d.expiryTime <= d.createdAt + duration.value(24, 'h');
    }
    // --- OFFERS COLLECTION ---
    // Document ID: {offerId}
    match /offers/{offerId} {
      // Revoked vendors may establish absence for safe orphan cleanup. This
      // grants no reads of existing private offers; writes still need approval.
      allow get: if isVendor()
        && !exists(/databases/$(database)/documents/offers/$(offerId));
      // Anyone can read active offers; vendors can read all their own offers
      allow read: if (resource.data.status == 'active')
        || (isAuthenticated() && resource.data.vendorId == request.auth.uid);

      allow create: if isApprovedVendor() && validOffer(request.resource.data)
        && validPublicationTime(request.resource.data)
        && confirmedStore(request.resource.data) && validImage(request.resource.data, offerId)
        && request.resource.data.status in ['active','draft'];
      // Legacy documents remain readable. Any future edit must explicitly add a
      // stable category; unchanged legacy images can retain their old URL.
      allow update: if isApprovedVendor() && resource.data.vendorId == request.auth.uid
        && request.resource.data.vendorId == resource.data.vendorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.latitude == resource.data.latitude
        && request.resource.data.longitude == resource.data.longitude
        && request.resource.data.geohash == resource.data.geohash
        && (!('locationConfirmedAt' in resource.data)
          ? (!('locationConfirmedAt' in request.resource.data) || confirmedStore(request.resource.data))
          : request.resource.data.locationConfirmedAt == resource.data.locationConfirmedAt)
        && validOffer(request.resource.data)
        && (request.resource.data.expiryTime == resource.data.expiryTime
          || (request.resource.data.expiryTime > request.time
            && request.resource.data.expiryTime <= resource.data.createdAt + duration.value(24, 'h')))
        && (validImage(request.resource.data, offerId)
          || (!resource.data.keys().hasAny(['imagePath','imageContentType','imageSize'])
            && request.resource.data.imageUrl == resource.data.imageUrl
            && !request.resource.data.keys().hasAny(['imagePath','imageContentType','imageSize'])))
        && request.resource.data.status in ['active','expired','deleted','draft'];
      allow delete: if isOwner(resource.data.vendorId);
    }
  }
}
