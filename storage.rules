rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper to check if authenticated user is an approved vendor in Firestore
    function isApprovedVendor() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'vendor'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.approvalStatus == 'approved';
    }

    function owner(vendorId) { return request.auth != null && request.auth.uid == vendorId; }
    function validUpload(fileName) {
      return request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && ((request.resource.contentType == 'image/jpeg' && fileName.matches('.*\\.(jpg|jpeg)'))
          || (request.resource.contentType == 'image/png' && fileName.matches('.*\\.png'))
          || (request.resource.contentType == 'image/webp' && fileName.matches('.*\\.webp')));
    }
    // Legacy images remain readable and owners retain cleanup authorization.
    match /offers/{vendorId}/{fileName} {
      allow read: if true;
      allow delete: if owner(vendorId);
      allow create, update: if owner(vendorId) && isApprovedVendor() && validUpload(fileName);
    }
    match /offers/{vendorId}/{offerId}/{fileName} {
      allow read: if true;
      // Deletion has no request.resource (unlike upload). Allow orphan cleanup
      // after approval revocation, but protect the exact published reference.
      allow delete: if owner(vendorId)
        && (!firestore.exists(/databases/(default)/documents/offers/$(offerId))
          || firestore.get(/databases/(default)/documents/offers/$(offerId)).data.get('imagePath', '') != 'offers/' + vendorId + '/' + offerId + '/' + fileName);
      allow create, update: if owner(vendorId) && isApprovedVendor() && validUpload(fileName)
        && (resource == null || (request.resource.contentType == resource.contentType
          && request.resource.size == resource.size
          && request.resource.md5Hash == resource.md5Hash));
    }
  }
}
